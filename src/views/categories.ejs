<%- include("partials/header") %>

<main>
  <h1><%= title %></h1>

  <p>Explore our service project categories:</p>
  <% if (isAdmin) { %>
  <p><a class="button" href="/new-category">Create Category</a></p>
  <% } %>

  <ul>
    <% categories.forEach((category) => { %>
      <li>
        <strong>
          <a href="/category/<%= category.category_id %>">
            <%= category.name %>
          </a>
        </strong>
      </li>
    <% }); %>
  </ul>
</main>

<%- include("partials/footer") %>
